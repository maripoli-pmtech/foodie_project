generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?  // "produce", "dairy", "meat", "seafood", "pantry", "spices", "frozen", "bakery", "beverages", "other"
  defaultUnit String?  // "g", "ml", "piece", etc.

  // Phase 3: Nutrition per 100g
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?

  recipes     RecipeIngredient[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Recipe {
  id           String   @id @default(cuid())
  title        String
  description  String?
  instructions String   // stored as markdown
  imageUrl     String?
  servings     Int      @default(4)
  prepTime     Int?     // minutes
  cookTime     Int?     // minutes
  tags         String[] // e.g., ["vegetarian", "quick", "italian"]

  // Phase 3: Cached computed nutrition totals
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?

  ingredients  RecipeIngredient[]
  mealSlots    MealSlot[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Float
  unit         String     // "g", "kg", "ml", "l", "cup", "tbsp", "tsp", "piece", "pinch"
  notes        String?    // "finely chopped", "room temperature"

  @@unique([recipeId, ingredientId])
}

model MealSlot {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  mealType String   // "breakfast", "lunch", "dinner", "snack"
  servings Int      @default(1)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@index([date])
  @@index([recipeId])
}
